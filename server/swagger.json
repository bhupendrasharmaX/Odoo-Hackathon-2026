{
  "openapi": "3.0.0",
  "info": {
    "title": "TransitOps - Smart Transport Operations Platform API",
    "description": "Production-ready backend API docs for TransitOps platform including fleets, dispatches, fuel logs, maintenance scheduling and operations analytics.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API Base URL"
    }
  ],
  "paths": {
    "/auth/send-otp": {
      "post": {
        "summary": "Send Login OTP",
        "description": "Sends a 6-digit OTP code to the user's mobile number via configured SMS gateway.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobileNumber"],
                "properties": {
                  "mobileNumber": {
                    "type": "string",
                    "example": "9876543210"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully"
          }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP and Login",
        "description": "Verifies 6-digit OTP code and returns authenticated user object along with Access and Refresh tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobileNumber", "otp"],
                "properties": {
                  "mobileNumber": {
                    "type": "string",
                    "example": "9876543210"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": { "type": "string" },
                        "refreshToken": { "type": "string" },
                        "user": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vehicles": {
      "get": {
        "summary": "Get Vehicles",
        "description": "Retrieve list of registered fleet vehicles. Supports pagination, sorting, search, and status filters.",
        "responses": {
          "200": {
            "description": "Paginated list of vehicles"
          }
        }
      },
      "post": {
        "summary": "Register New Vehicle",
        "description": "Add new vehicle details to the database.",
        "responses": {
          "201": {
            "description": "Vehicle created"
          }
        }
      }
    },
    "/drivers": {
      "get": {
        "summary": "Get Drivers",
        "description": "List all active, suspended, or off-duty drivers.",
        "responses": {
          "200": {
            "description": "Paginated list of drivers"
          }
        }
      }
    },
    "/trips": {
      "get": {
        "summary": "Get Trips",
        "description": "List all dispatch trips with filters.",
        "responses": {
          "200": {
            "description": "List of trips"
          }
        }
      }
    },
    "/reports/dashboard": {
      "get": {
        "summary": "Get Dashboard KPIs",
        "description": "Retrieve all live fleet statistics, revenue MTD, fuel expenditure, and utilization rates.",
        "responses": {
          "200": {
            "description": "Dashboard stats object"
          }
        }
      }
    }
  }
}
